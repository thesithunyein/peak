# Copy to .env.local and fill in real values. .env.local is gitignored.

# Featherless (OpenAI-compatible) inference. Used for draft generation.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-72B-Instruct

# Optional. Enables "Send to Telegram" publishing. Both are required together.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
